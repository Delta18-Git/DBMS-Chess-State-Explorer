# Copy to .env.local. Do not commit real credentials.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=chess_intel
DB_USER=chess_app
DB_PASSWORD=replace-with-a-local-database-password
# Used by Docker Compose / scripts/dev-db.sh only. Runtime Next.js never needs the root account.
MYSQL_ROOT_PASSWORD=replace-with-a-different-root-password

# Neo4j graph mirror (positions + moves). Bolt URI, user is always "neo4j" for the container.
NEO4J_URI=bolt://127.0.0.1:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=replace-with-a-neo4j-password-8-chars-plus

# Where the web UI's server code reaches the /api routes (defaults to http://127.0.0.1:$PORT).
# Fixed on purpose: never derived from the request Host header.
# INTERNAL_API_URL=http://127.0.0.1:3000
