# `npm run setup` writes .env.local with random passwords for you. Copy this only to configure by hand.
# Never commit real credentials.
DB_HOST=127.0.0.1
DB_PORT=3307
DB_NAME=chess_intel
DB_USER=chess_app
DB_PASSWORD=replace-with-a-local-database-password
# Used only by `npm run setup` to create the container/database. The running app never uses root.
MYSQL_ROOT_PASSWORD=replace-with-a-different-root-password

# Neo4j graph mirror (Bolt). Browser UI at http://127.0.0.1:$NEO4J_HTTP_PORT
NEO4J_URI=bolt://127.0.0.1:7688
NEO4J_USER=neo4j
NEO4J_PASSWORD=replace-with-a-neo4j-password-8-chars-plus
NEO4J_HTTP_PORT=7475

# Optional
# MYSQL_CONTAINER=chess-mysql            container names managed by setup
# NEO4J_CONTAINER=chess-neo4j
# STOCKFISH_PATH=/path/to/stockfish      native engine (faster); default is the bundled WebAssembly build
# ENGINE_WORKERS=8                       parallel engine processes for scoring
# INTERNAL_API_URL=http://127.0.0.1:3000 where server code reaches /api (never derived from the Host header)
