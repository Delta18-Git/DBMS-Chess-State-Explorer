{
  "name": "chess-state-explorer",
  "version": "0.1.0",
  "private": true,
  "engines": { "node": ">=22" },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/unit.test.ts",
    "test:integration": "node --env-file-if-exists=.env.local --import tsx --test tests/integration.test.ts",
    "db:init": "node --env-file-if-exists=.env.local --import tsx scripts/init-db.ts",
    "user:create": "node --env-file-if-exists=.env.local --import tsx scripts/create-user.ts"
  },
  "dependencies": {
    "chess.js": "^1.4.0",
    "mysql2": "^3.24.6",
    "next": "^16.4.5",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "tsx": "^4.23.15",
    "typescript": "~5.9.3"
  }
}
